rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'admin@256.kg'
        ];
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /reviews/{userId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 2000;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    match /users/{userId}/favorites/{productId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['productId', 'createdAt'])
        && request.resource.data.productId == productId;
    }

    match /users/{userId}/profile/{profileId} {
      allow read, delete: if signedIn()
        && request.auth.uid == userId
        && profileId == 'contact';
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && profileId == 'contact'
        && request.resource.data.keys().hasOnly(['phone'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 30;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 500
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'status', 'createdAt', 'date', 'customerName',
          'phone', 'address', 'comment', 'items', 'total'
        ]);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /system/{documentId} {
      allow read: if documentId == 'storeSettings' || isAdmin();
      allow write: if isAdmin();
    }

    match /emailLoginChallenges/{documentId} {
      allow read, write: if false;
    }

    match /emailLoginRateLimits/{documentId} {
      allow read, write: if false;
    }

    match /emailLoginIpRateLimits/{documentId} {
      allow read, write: if false;
    }

    match /telegramOrderRateLimits/{documentId} {
      allow read, write: if false;
    }
  }
}
